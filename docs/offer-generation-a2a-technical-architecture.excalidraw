    },
    {
      "id": "n1-interface-0-body",
      "type": "text",
      "x": 86,
      "y": 1809.5,
      "width": 1134,
      "height": 236.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "n1-group-interface-0"
      ],
      "frameId": "n1-frame",
      "index": "b1k",
      "roundness": null,
      "seed": 221034753,
      "version": 1,
      "versionNonce": 3190899,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795365707110,
      "link": null,
      "locked": false,
      "text": "POST /simulation/workflows (or /workflows) admits a request keyed by analyst and requestId.\n↳ {requestId, draftId, intent, budget, lockedStages?, seed?, autoExecute?}\n↳ customerPopulation: {selectedProduct?, feeSensitivity?}, or {populationId, validationPopulationId}.\nGET /simulation/workflows/{id} → {id, version, workflow, usage}. Evaluations and artifacts are subresources.\nPOST …/{id}/messages → {expectedVersion, questionId?, text}. POST …/{id}/cancel stops execution.\nPOST …/{id}/scope-confirmations → {expectedVersion, scopeHash} for required scope confirmation.\nPOST …/{id}/publication-previews → {candidateId, note}.\nPOST /publication-previews/{previewId}/confirm → {previewHash, confirm:true}.\nThe analyst token is selected by AiProxy. Browser Business REST starts at /web-api/ai/*.",
      "originalText": "POST /simulation/workflows (or /workflows) admits a request keyed by analyst and requestId.\n↳ {requestId, draftId, intent, budget, lockedStages?, seed?, autoExecute?}\n↳ customerPopulation: {selectedProduct?, feeSensitivity?}, or {populationId, validationPopulationId}.\nGET /simulation/workflows/{id} → {id, version, workflow, usage}. Evaluations and artifacts are subresources.\nPOST …/{id}/messages → {expectedVersion, questionId?, text}. POST …/{id}/cancel stops execution.\nPOST …/{id}/scope-confirmations → {expectedVersion, scopeHash} for required scope confirmation.\nPOST …/{id}/publication-previews → {candidateId, note}.\nPOST /publication-previews/{previewId}/confirm → {previewHash, confirm:true}.\nThe analyst token is selected by AiProxy. Browser Business REST starts at /web-api/ai/*.",
      "fontSize": 21,
      "fontFamily": 2,
      "lineHeight": 1.25,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true
    },
