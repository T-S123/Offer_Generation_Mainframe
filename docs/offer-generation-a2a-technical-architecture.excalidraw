    {
      "id": "n1-interface-1-title",
      "type": "text",
      "x": 2060,
      "y": 1764,
      "width": 473,
      "height": 32.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "n1-group-interface-1"
      ],
      "frameId": "n1-frame",
      "index": "b1m",
      "roundness": null,
      "seed": 221227367,
      "version": 1,
      "versionNonce": 3225185,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795365707110,
      "link": null,
      "locked": false,
      "text": "Bank owner REST · /api/v1/business",
      "originalText": "Bank owner REST · /api/v1/business",
      "fontSize": 26,
      "fontFamily": 1,
      "lineHeight": 1.25,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true
    },
    {
      "id": "n1-interface-1-body",
      "type": "text",
      "x": 2060,
      "y": 1809.5,
      "width": 1273,
      "height": 210,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "n1-group-interface-1"
      ],
      "frameId": "n1-frame",
      "index": "b1n",
      "roundness": null,
      "seed": 221323674,
      "version": 1,
      "versionNonce": 3242328,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795365707110,
      "link": null,
      "locked": false,
      "text": "GET /drafts/{id} reads a versioned offer and policy. POST /drafts + PUT /drafts/{id} materialize trial drafts.\nPOST /customer-populations {selectedProduct?,feeSensitivity?} → {discovery,validation} descriptors.\nThe owner snapshots saved bank profiles. GET /populations or POST /populations {count,seed} supplies synthetic cohorts.\nPOST /runs {draftId,draftVersion,populationId,seed} and GET /runs/{id} submit and read the owner experiment.\nPOST /runs/{id}/publish {confirm:true,note} writes the bank catalog and returns an offer receipt.\nAi calls carry bank-local bearer credentials. POST admissions use stable Idempotency-Key values.\nEngine → Offer JVM POST /api/v1/business-analysis sends populationId, seed, asOf, product, rows and populationSource.\n↳ returns {rows,report,model}. GET /api/v1/storage/selected-customers?product&after filters by actual selections.",
      "originalText": "GET /drafts/{id} reads a versioned offer and policy. POST /drafts + PUT /drafts/{id} materialize trial drafts.\nPOST /customer-populations {selectedProduct?,feeSensitivity?} → {discovery,validation} descriptors.\nThe owner snapshots saved bank profiles. GET /populations or POST /populations {count,seed} supplies synthetic cohorts.\nPOST /runs {draftId,draftVersion,populationId,seed} and GET /runs/{id} submit and read the owner experiment.\nPOST /runs/{id}/publish {confirm:true,note} writes the bank catalog and returns an offer receipt.\nAi calls carry bank-local bearer credentials. POST admissions use stable Idempotency-Key values.\nEngine → Offer JVM POST /api/v1/business-analysis sends populationId, seed, asOf, product, rows and populationSource.\n↳ returns {rows,report,model}. GET /api/v1/storage/selected-customers?product&after filters by actual selections.",
      "fontSize": 21,
      "fontFamily": 2,
      "lineHeight": 1.25,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true
    },
