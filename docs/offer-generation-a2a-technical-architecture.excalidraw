    {
      "id": "n2-interface-0-body",
      "type": "text",
      "x": 86,
      "y": 4440.5,
      "width": 1279,
      "height": 210,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "n2-group-interface-0"
      ],
      "frameId": "n2-frame",
      "index": "b4S",
      "roundness": null,
      "seed": 237214329,
      "version": 1,
      "versionNonce": 6070923,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795365707110,
      "link": null,
      "locked": false,
      "text": "POST /feedback/investigations {publicationId?,requestId,text,sourceMode,scope?,customerReference?,budget}.\nPOST /publications/{publicationId}/investigations also allows the publication ID in the route.\nscope includes startDate, endDate, timezone, dateBasis, variant, offerVersion and evidenceCutoff.\nGET /feedback/workflows/{id} → {id,version,workflow,usage}. POST …/{id}/messages {expectedVersion,questionId?,text}.\nPOST /performance/publications/{id}/measurements → immutable {snapshotRef,result}.\nPOST /performance/publications/{id}/eligibility {customerReference,scope} → customer trace + snapshotRef.\nPOST /feedback/briefings is a separate budgeted analysis over measured snapshots.\nsourceMode selects DEMO or OBSERVED_REAL. Demo Business browser REST starts at /web-api/ai/*.",
      "originalText": "POST /feedback/investigations {publicationId?,requestId,text,sourceMode,scope?,customerReference?,budget}.\nPOST /publications/{publicationId}/investigations also allows the publication ID in the route.\nscope includes startDate, endDate, timezone, dateBasis, variant, offerVersion and evidenceCutoff.\nGET /feedback/workflows/{id} → {id,version,workflow,usage}. POST …/{id}/messages {expectedVersion,questionId?,text}.\nPOST /performance/publications/{id}/measurements → immutable {snapshotRef,result}.\nPOST /performance/publications/{id}/eligibility {customerReference,scope} → customer trace + snapshotRef.\nPOST /feedback/briefings is a separate budgeted analysis over measured snapshots.\nsourceMode selects DEMO or OBSERVED_REAL. Demo Business browser REST starts at /web-api/ai/*.",
      "fontSize": 21,
      "fontFamily": 2,
      "lineHeight": 1.25,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true
    },
