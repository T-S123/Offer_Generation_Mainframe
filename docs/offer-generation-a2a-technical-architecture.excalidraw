      "width": 1898,
      "height": 316,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0.4,
      "opacity": 100,
      "groupIds": [
        "n3-group-interface-3"
      ],
      "frameId": "n3-frame",
      "index": "b7F",
      "roundness": {
        "type": 3,
        "value": 13
      },
      "seed": 253875440,
      "version": 1,
      "versionNonce": 9036662,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795365707110,
      "link": null,
      "locked": false
    },
    {
      "id": "n3-interface-3-title",
      "type": "text",
      "x": 2060,
      "y": 7366,
      "width": 427,
      "height": 32.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "n3-group-interface-3"
      ],
      "frameId": "n3-frame",
      "index": "b7G",
      "roundness": null,
      "seed": 253971747,
      "version": 1,
      "versionNonce": 9053805,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795365707110,
      "link": null,
      "locked": false,
      "text": "JDBC writes and profile isolation",
      "originalText": "JDBC writes and profile isolation",
      "fontSize": 26,
      "fontFamily": 1,
      "lineHeight": 1.25,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true
    },
    {
      "id": "n3-interface-3-body",
      "type": "text",
      "x": 2060,
      "y": 7411.5,
      "width": 1212,
      "height": 183.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "n3-group-interface-3"
      ],
      "frameId": "n3-frame",
      "index": "b7H",
      "roundness": null,
      "seed": 254068054,
      "version": 1,
      "versionNonce": 9070948,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795365707110,
      "link": null,
      "locked": false,
      "text": "AI records are INSERTed once and UPDATEd by expected version. Work is rechecked against current profileVersion.\nAI registry uses bank-local JDBC. Agent task/audit writes remain in their respective role schemas.\nEngine reads profiles from bank H2 and persists offer_variant_qualifications in owner PostgreSQL.\nOffer JVM inserts personalization_sessions and session_offers. It locks active session and quote rows FOR UPDATE.\nQuote reads check customer and session. Selection persists terms, a selection receipt and storage snapshot.\nWebServer selects the bank and customer on the server. AiProxy forwards using that bank's analyst credential.\nThe owner validates current customer/profile/session and offer/rule versions when it qualifies or issues a quote.",
      "originalText": "AI records are INSERTed once and UPDATEd by expected version. Work is rechecked against current profileVersion.\nAI registry uses bank-local JDBC. Agent task/audit writes remain in their respective role schemas.\nEngine reads profiles from bank H2 and persists offer_variant_qualifications in owner PostgreSQL.\nOffer JVM inserts personalization_sessions and session_offers. It locks active session and quote rows FOR UPDATE.\nQuote reads check customer and session. Selection persists terms, a selection receipt and storage snapshot.\nWebServer selects the bank and customer on the server. AiProxy forwards using that bank's analyst credential.\nThe owner validates current customer/profile/session and offer/rule versions when it qualifies or issues a quote.",
      "fontSize": 21,
      "fontFamily": 2,
      "lineHeight": 1.25,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true
    },
    {
      "id": "n3-evidence",
      "type": "text",
      "x": 65,
      "y": 7689,
      "width": 1755,
      "height": 22.5,
      "angle": 0,
      "strokeColor": "#434343",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "n3-frame",
      "index": "b7I",
      "roundness": null,
      "seed": 254164361,
      "version": 1,
      "versionNonce": 9088091,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795365707110,
