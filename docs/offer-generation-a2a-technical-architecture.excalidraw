    {
      "id": "n2-orchestrator-body",
      "type": "text",
      "x": 1495,
      "y": 3176.5,
      "width": 954,
      "height": 115.625,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
