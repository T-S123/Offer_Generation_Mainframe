    {
      "id": "n3-interface-2-title",
      "type": "text",
      "x": 86,
      "y": 7366,
      "width": 554,
      "height": 32.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "n3-group-interface-2"
      ],
      "frameId": "n3-frame",
      "index": "b7D",
      "roundness": null,
      "seed": 253682826,
      "version": 1,
      "versionNonce": 9002376,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795365707110,
      "link": null,
      "locked": false,
      "text": "Agent HTTP · scoped read tools and budgets",
      "originalText": "Agent HTTP · scoped read tools and budgets",
      "fontSize": 26,
      "fontFamily": 1,
      "lineHeight": 1.25,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true
    },
    {
      "id": "n3-interface-2-body",
      "type": "text",
      "x": 86,
      "y": 7411.5,
      "width": 1353,
      "height": 183.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "n3-group-interface-2"
      ],
      "frameId": "n3-frame",
      "index": "b7E",
      "roundness": null,
      "seed": 253779133,
      "version": 1,
      "versionNonce": 9019519,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795365707110,
      "link": null,
      "locked": false,
      "text": "A2A with ORCHESTRATOR bearer uses Request 1.0.0 {schemaVersion,requestId,workflowId,stepId,planRevision,deadline,payload}.\nPOST /internal/personalization-tools {request,name,arguments:{}} returns registered workflow evidence.\nContext receives profile facts. Designer receives policy limits. Eligibility and Guide receive owner results.\nPOST /internal/budget {request,callId,maxTokens}. POST /internal/usage {request,callId,actualTokens}.\nRole tokens and registered STEP fingerprints constrain tool reads and call reservations.\nA2A returns Task status and artifacts[].parts[].data with Result decision, observations and model metadata.\nThe ORCHESTRATOR uses owner snapshots and exact candidate/quote IDs for writes.",
      "originalText": "A2A with ORCHESTRATOR bearer uses Request 1.0.0 {schemaVersion,requestId,workflowId,stepId,planRevision,deadline,payload}.\nPOST /internal/personalization-tools {request,name,arguments:{}} returns registered workflow evidence.\nContext receives profile facts. Designer receives policy limits. Eligibility and Guide receive owner results.\nPOST /internal/budget {request,callId,maxTokens}. POST /internal/usage {request,callId,actualTokens}.\nRole tokens and registered STEP fingerprints constrain tool reads and call reservations.\nA2A returns Task status and artifacts[].parts[].data with Result decision, observations and model metadata.\nThe ORCHESTRATOR uses owner snapshots and exact candidate/quote IDs for writes.",
      "fontSize": 21,
      "fontFamily": 2,
      "lineHeight": 1.25,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true
    },
    {
      "id": "n3-interface-3",
      "type": "rectangle",
      "x": 2038,
