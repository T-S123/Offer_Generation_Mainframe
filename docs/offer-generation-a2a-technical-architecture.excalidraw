      "seed": 227102094,
      "version": 1,
      "versionNonce": 4270908,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795365707110,
      "link": null,
      "locked": false,
      "text": "InvestigationWorkflowService · FeedbackService · OutcomeService\nPerformanceService evaluates date/version/source scope over recorded bank evidence.\nWorkflowRuntime scans the shared registry for owned workflows on a 1 s fixed-delay tick.\nThe JVM owns REST, investigation tools and A2AClient. Its own agent also serves /a2a.\nOutcomeService polls after 10 s and on a 1 h fixed delay. The registry holds its cursor and outcome facts.",
      "originalText": "InvestigationWorkflowService · FeedbackService · OutcomeService\nPerformanceService evaluates date/version/source scope over recorded bank evidence.\nWorkflowRuntime scans the shared registry for owned workflows on a 1 s fixed-delay tick.\nThe JVM owns REST, investigation tools and A2AClient. Its own agent also serves /a2a.\nOutcomeService polls after 10 s and on a 1 h fixed delay. The registry holds its cursor and outcome facts.",
      "fontSize": 18.5,
      "fontFamily": 2,
      "lineHeight": 1.25,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true
    },
