    {
      "id": "n3-interface-1-title",
      "type": "text",
      "x": 2060,
      "y": 7026,
      "width": 802,
      "height": 32.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "n3-group-interface-1"
      ],
      "frameId": "n3-frame",
      "index": "b7A",
      "roundness": null,
      "seed": 253393905,
      "version": 1,
      "versionNonce": 8950947,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795365707110,
      "link": null,
      "locked": false,
      "text": "Owner REST · /api/v1/offer-creation/customers/{customerId}",
      "originalText": "Owner REST · /api/v1/offer-creation/customers/{customerId}",
      "fontSize": 26,
      "fontFamily": 1,
      "lineHeight": 1.25,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true
    },
    {
      "id": "n3-interface-1-body",
      "type": "text",
      "x": 2060,
      "y": 7071.5,
      "width": 1162,
      "height": 210,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "n3-group-interface-1"
      ],
      "frameId": "n3-frame",
      "index": "b7B",
      "roundness": null,
      "seed": 253490212,
      "version": 1,
      "versionNonce": 8968090,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795365707110,
      "link": null,
      "locked": false,
      "text": "POST /personalization-sessions {sessionId,expiresAt} registers a session. GET ?sessionId checks validity.\nGET /personalization-context?profileVersion returns current profile, qualified offer set, policy and offersReady.\nPOST /personalization-candidates {requestId,responseId,responseVersion,policyVersion,terms,profileVersion,\n    customerPolicyVersion,ruleChanges} → approval, fit metrics and improvesFit.\nPOST /session-offers?sessionId {approvalId,profileVersion} → versioned, session-bound quote.\nOfferApi forwards these calls to the marketing JVM under /api/v1/customers/{customerId} with its own key.\nMarketing → Engine /api/v1/offer-source/customer-context/{id}, /variants and /approvals/{id}.\nEngine policy evaluates local COBOL rules and calls Credit JVM POST /api/v1/credit/assessments.",
      "originalText": "POST /personalization-sessions {sessionId,expiresAt} registers a session. GET ?sessionId checks validity.\nGET /personalization-context?profileVersion returns current profile, qualified offer set, policy and offersReady.\nPOST /personalization-candidates {requestId,responseId,responseVersion,policyVersion,terms,profileVersion,\n    customerPolicyVersion,ruleChanges} → approval, fit metrics and improvesFit.\nPOST /session-offers?sessionId {approvalId,profileVersion} → versioned, session-bound quote.\nOfferApi forwards these calls to the marketing JVM under /api/v1/customers/{customerId} with its own key.\nMarketing → Engine /api/v1/offer-source/customer-context/{id}, /variants and /approvals/{id}.\nEngine policy evaluates local COBOL rules and calls Credit JVM POST /api/v1/credit/assessments.",
      "fontSize": 21,
      "fontFamily": 2,
      "lineHeight": 1.25,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true
    },
