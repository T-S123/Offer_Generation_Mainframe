      "frameId": "n3-frame",
      "index": "b5j",
      "roundness": null,
      "seed": 244822582,
      "version": 1,
      "versionNonce": 7425220,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795365707110,
      "link": null,
      "locked": false,
      "text": "PersonalizationWorkflowService · WorkflowRuntime\nREST and internal tools operate on the customer, saved profile version and active session.\nWorkflowRuntime scans owned WORKFLOW rows on a 1 s fixed-delay tick.\nA2AClient delegates and polls. ORCHESTRATOR also serves its own /a2a planning tasks.\nOwner REST validates candidates and issues quotes. The customer submits selection separately.",
      "originalText": "PersonalizationWorkflowService · WorkflowRuntime\nREST and internal tools operate on the customer, saved profile version and active session.\nWorkflowRuntime scans owned WORKFLOW rows on a 1 s fixed-delay tick.\nA2AClient delegates and polls. ORCHESTRATOR also serves its own /a2a planning tasks.\nOwner REST validates candidates and issues quotes. The customer submits selection separately.",
      "fontSize": 18.5,
      "fontFamily": 2,
      "lineHeight": 1.25,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true
    },
    {
      "id": "n3-registry",
      "type": "rectangle",
