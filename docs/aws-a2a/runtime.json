          "Ref": "Discovery"
        },
        "DnsConfig": {
          "RoutingPolicy": "MULTIVALUE",
          "DnsRecords": [
            {
              "Type": "A",
              "TTL": 10
            }
          ]
        },
        "HealthCheckCustomConfig": {
          "FailureThreshold": 1
        }
      }
