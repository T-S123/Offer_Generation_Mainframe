                  ]
                }
              },
              {
                "Name": "DB_HOST",
                "Value": {
                  "Fn::ImportValue": {
                    "Fn::Sub": "${FoundationStack}-DbHost"
                  }
                }
              },
              {
                "Name": "AI_MODEL",
                "Value": {
                  "Ref": "ModelId"
                }
              },
              {
                "Name": "AI_DEFAULT_MAX_USD",
                "Value": "10"
              },
              {
                "Name": "AI_CUSTOMER_MAX_COST_USD",
                "Value": "15"
              },
              {
                "Name": "JAVA_TOOL_OPTIONS",
                "Value": "-Xms40m -Xmx425m -XX:ActiveProcessorCount=1"
              }
            ],
            "Secrets": [
              {
                "Name": "OGM_BANK_SEED",
                "ValueFrom": {
                  "Fn::ImportValue": {
                    "Fn::Sub": "${FoundationStack}-SeedSecret"
                  }
                }
              },
              {
                "Name": "OGM_APP_DB_PASSWORD",
                "ValueFrom": {
                  "Fn::ImportValue": {
                    "Fn::Sub": "${FoundationStack}-AppSecret"
                  }
                }
              },
              {
                "Name": "OPENAI_API_KEY",
                "ValueFrom": {
                  "Ref": "OpenAiSecretArn"
                }
              }
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Fn::ImportValue": {
                    "Fn::Sub": "${FoundationStack}-AppLogGroup"
                  }
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "feedback"
