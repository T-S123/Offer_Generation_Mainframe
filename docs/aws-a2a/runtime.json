{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Three private ECS A2A services and a persistent synthetic bank owner",
  "Parameters": {
    "FoundationStack": {
      "Type": "String",
      "Description": "Name of the successful foundation stack",
      "Default": "ogm-foundation"
    },
    "Release": {
      "Type": "String",
      "Description": "Immutable image release suffix such as r001",
      "Default": "r001",
      "AllowedPattern": "r[0-9]{3,6}"
    },
    "OwnerRelease": {
      "Type": "String",
      "Description": "Immutable image release suffix such as r001",
      "Default": "r001",
      "AllowedPattern": "r[0-9]{3,6}"
    },
    "OpenAiSecretArn": {
      "Type": "String",
      "Description": "ARN of the same-region plaintext OpenAI project secret",
      "AllowedPattern": "arn:aws:secretsmanager:us-east-1:[0-9]{12}:secret:.+"
    },
    "ModelId": {
      "Type": "String",
      "Description": "Responses API model verified for the supplied project",
      "Default": "gpt-6-astra",
      "AllowedPattern": "[A-Za-z0-9_:.\\-]{1,100}"
    },
    "OwnerAmi": {
      "Type": "AWS::EC2::Image::Id",
      "Description": "Pinned Amazon Linux 2023 x86_64 AMI ID from CloudShell preflight"
    }
  },
  "Resources": {
    "OwnerRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ec2.amazonaws.com"
              },
              "Action": [
                "sts:AssumeRole"
              ]
            }
          ]
        },
        "ManagedPolicyArns": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/AmazonSSMManagedInstanceCore"
          }
        ],
        "Policies": [
          {
            "PolicyName": "OgmScopedAccess",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:GetAuthorizationToken"
                  ],
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:BatchGetImage",
                    "ecr:GetDownloadUrlForLayer",
                    "ecr:BatchCheckLayerAvailability"
                  ],
                  "Resource": {
                    "Fn::ImportValue": {
                      "Fn::Sub": "${FoundationStack}-RepositoryArn"
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "secretsmanager:GetSecretValue"
                  ],
                  "Resource": [
                    {
                      "Fn::ImportValue": {
                        "Fn::Sub": "${FoundationStack}-MasterSecret"
                      }
                    },
                    {
                      "Fn::ImportValue": {
                        "Fn::Sub": "${FoundationStack}-AppSecret"
                      }
                    },
                    {
                      "Fn::ImportValue": {
                        "Fn::Sub": "${FoundationStack}-SeedSecret"
                      }
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": [
                      "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:${Group}:*",
                      {
                        "Group": {
                          "Fn::ImportValue": {
                            "Fn::Sub": "${FoundationStack}-OwnerLogGroup"
                          }
                        }
                      }
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "cloudformation:SignalResource"
                  ],
                  "Resource": {
                    "Ref": "AWS::StackId"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "OwnerProfile": {
      "Type": "AWS::IAM::InstanceProfile",
      "Properties": {
        "Roles": [
          {
            "Ref": "OwnerRole"
          }
        ]
      }
    },
    "Owner": {
      "Type": "AWS::EC2::Instance",
      "Properties": {
        "ImageId": {
          "Ref": "OwnerAmi"
        },
        "InstanceType": "t3.large",
        "IamInstanceProfile": {
          "Ref": "OwnerProfile"
        },
        "NetworkInterfaces": [
          {
            "DeviceIndex": "0",
            "AssociatePublicIpAddress": false,
            "SubnetId": {
              "Fn::ImportValue": {
                "Fn::Sub": "${FoundationStack}-PrivateA"
              }
            },
            "GroupSet": [
              {
                "Fn::ImportValue": {
                  "Fn::Sub": "${FoundationStack}-OwnerSecurityGroup"
                }
              }
            ]
          }
        ],
        "MetadataOptions": {
          "HttpEndpoint": "enabled",
          "HttpTokens": "required",
          "HttpPutResponseHopLimit": 1
        },
        "BlockDeviceMappings": [
          {
            "DeviceName": "/dev/xvda",
            "Ebs": {
              "VolumeType": "gp3",
              "VolumeSize": 40,
              "Encrypted": true,
              "DeleteOnTermination": true
            }
          }
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-emma-owner"
            }
          }
        ],
        "UserData": {
          "Fn::Base64": {
            "Fn::Sub": [
              "#!/bin/bash\nset -euo pipefail\nexport AWS_DEFAULT_REGION='${REGION}'\nstack='${STACK}'\nfinish() {\n  code=$?\n  status=SUCCESS\n  if [ \"$code\" -ne 0 ]; then status=FAILURE; fi\n  aws cloudformation signal-resource --stack-name \"$stack\" --logical-resource-id Owner --unique-id \"$(hostname)\" --status \"$status\"\n}\ntrap finish EXIT\n\ndnf install -y docker jq\nsystemctl enable --now docker\n\nrepository='${REPOSITORY}'\nruntime_image=\"$repository:ogm-${OWNER_RELEASE}\"\nkafka_image=\"$repository:kafka-${OWNER_RELEASE}\"\naws ecr get-login-password | docker login --username AWS --password-stdin \"${REGISTRY}\"\ndocker pull \"$runtime_image\"\ndocker pull \"$kafka_image\"\ndocker logout \"${REGISTRY}\"\n\nexport PGHOST='${DB_HOST}' PGPORT=5432 PGDATABASE=ogm PGSSLMODE=verify-full PGSSLROOTCERT=/etc/ssl/certs/ogm-rds-bundle.pem\nmaster=$(aws secretsmanager get-secret-value --secret-id '${MASTER_SECRET}' --query SecretString --output text)\nexport PGUSER=$(jq -r .username <<<\"$master\") PGPASSWORD=$(jq -r .password <<<\"$master\")\nunset master\nexport OGM_APP_DB_PASSWORD=$(aws secretsmanager get-secret-value --secret-id '${APP_SECRET}' --query SecretString --output text)\nexport OGM_BANK_SEED=$(aws secretsmanager get-secret-value --secret-id '${SEED_SECRET}' --query SecretString --output text)\ndocker run --rm -i --network host --entrypoint /usr/bin/psql \\\n  -e PGHOST -e PGPORT -e PGDATABASE -e PGSSLMODE -e PGSSLROOTCERT -e PGUSER -e PGPASSWORD -e OGM_APP_DB_PASSWORD \\\n  \"$runtime_image\" --set ON_ERROR_STOP=1 <<'SQL'\n\\getenv app_password OGM_APP_DB_PASSWORD\nSELECT 'CREATE ROLE ogm_app LOGIN' WHERE NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'ogm_app')\n\\gexec\nALTER ROLE ogm_app PASSWORD :'app_password';\nGRANT CONNECT, CREATE ON DATABASE ogm TO ogm_app;\nGRANT USAGE, CREATE ON SCHEMA public TO ogm_app;\nSQL\nunset PGPASSWORD PGUSER\n\ninstall -d -m 0700 -o 1000 -g 1000 /var/lib/ogm/kafka\ninstall -d -m 0700 -o 10001 -g 10001 /var/lib/ogm/runtime\n\ndocker run -d --name ogm-kafka --network host --restart unless-stopped \\\n  --log-driver awslogs --log-opt \"awslogs-region=$AWS_DEFAULT_REGION\" --log-opt \"awslogs-group=${OWNER_LOGS}\" --log-opt awslogs-create-group=false --log-opt awslogs-stream=kafka \\\n  --mount type=bind,src=/var/lib/ogm/kafka,dst=/tmp/kraft-combined-logs \\\n  -e CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk \\\n  -e KAFKA_NODE_ID=1 -e KAFKA_PROCESS_ROLES=broker,controller \\\n  -e KAFKA_LISTENERS=PLAINTEXT://127.0.0.1:9092,CONTROLLER://127.0.0.1:9093 \\\n  -e KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://127.0.0.1:9092 \\\n  -e KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER \\\n  -e KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT \\\n  -e KAFKA_CONTROLLER_QUORUM_VOTERS=1@localhost:9093 -e KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1 \\\n  -e KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1 -e KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1 \\\n  -e KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS=0 -e KAFKA_NUM_PARTITIONS=12 \\\n  -e KAFKA_LOG_DIRS=/tmp/kraft-combined-logs \"$kafka_image\"\nkafka_ready=no\nfor attempt in $(seq 1 30); do\n  if timeout 10s docker exec ogm-kafka /opt/kafka/bin/kafka-topics.sh --bootstrap-server localhost:9092 --list >/dev/null 2>&1; then\n    kafka_ready=yes\n    break\n  fi\n  sleep 5\ndone\ntest \"$kafka_ready\" = yes\n\nexport DB_HOST=\"$PGHOST\" PEER_DOMAIN='${PEER_DOMAIN}'\ndocker run -d --name ogm-owner --network host --restart unless-stopped --stop-timeout 25 \\\n  --log-driver awslogs --log-opt \"awslogs-region=$AWS_DEFAULT_REGION\" --log-opt \"awslogs-group=${OWNER_LOGS}\" --log-opt awslogs-create-group=false --log-opt awslogs-stream=bank \\\n  --mount type=bind,src=/var/lib/ogm/runtime,dst=/opt/ogm/runtime \\\n  -e DB_HOST -e PEER_DOMAIN -e OGM_APP_DB_PASSWORD -e OGM_BANK_SEED \\\n  -e KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092 \\\n  -e 'JAVA_TOOL_OPTIONS=-Xms48m -Xmx768m -XX:ActiveProcessorCount=2' \"$runtime_image\"\nunset OGM_APP_DB_PASSWORD OGM_BANK_SEED\nowner_ready=no\nfor attempt in $(seq 1 60); do\n  if docker exec ogm-owner bash -c 'curl -fsS --max-time 3 http://127.0.0.1:8090/api/v1/health >/dev/null && curl -fsS --max-time 3 -H \"Authorization: Bearer $(cat runtime/marketing-api-token)\" http://127.0.0.1:8092/api/v1/health >/dev/null' 2>/dev/null; then\n     owner_ready=yes\n     break\n  fi\n  sleep 4\ndone\ntest \"$owner_ready\" = yes\n",
              {
                "REGION": {
                  "Ref": "AWS::Region"
                },
                "STACK": {
                  "Ref": "AWS::StackName"
                },
                "REPOSITORY": {
                  "Fn::ImportValue": {
                    "Fn::Sub": "${FoundationStack}-RepositoryUri"
                  }
                },
                "OWNER_RELEASE": {
                  "Ref": "OwnerRelease"
                },
                "REGISTRY": {
                  "Fn::Sub": "${AWS::AccountId}.dkr.ecr.${AWS::Region}.${AWS::URLSuffix}"
                },
                "DB_HOST": {
                  "Fn::ImportValue": {
                    "Fn::Sub": "${FoundationStack}-DbHost"
                  }
                },
                "MASTER_SECRET": {
                  "Fn::ImportValue": {
                    "Fn::Sub": "${FoundationStack}-MasterSecret"
                  }
                },
                "APP_SECRET": {
                  "Fn::ImportValue": {
                    "Fn::Sub": "${FoundationStack}-AppSecret"
                  }
                },
                "SEED_SECRET": {
                  "Fn::ImportValue": {
                    "Fn::Sub": "${FoundationStack}-SeedSecret"
                  }
                },
                "OWNER_LOGS": {
                  "Fn::ImportValue": {
                    "Fn::Sub": "${FoundationStack}-OwnerLogGroup"
                  }
                },
                "PEER_DOMAIN": {
                  "Fn::Sub": "${AWS::StackName}.ogm.internal"
                }
              }
            ]
          }
        }
      },
      "CreationPolicy": {
        "ResourceSignal": {
          "Count": 1,
          "Timeout": "PT30M"
        }
      }
    },
    "Cluster": {
      "Type": "AWS::ECS::Cluster",
      "Properties": {
        "ClusterName": {
          "Fn::Sub": "${AWS::StackName}-ecs"
        }
      }
    },
    "Discovery": {
      "Type": "AWS::ServiceDiscovery::PrivateDnsNamespace",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}.ogm.internal"
        },
        "Vpc": {
          "Fn::ImportValue": {
            "Fn::Sub": "${FoundationStack}-VpcId"
          }
        },
        "Description": "Stable names for same-bank compatibility and tool calls"
      }
    },
    "Alb": {
      "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
      "Properties": {
        "Scheme": "internal",
        "Type": "application",
        "IpAddressType": "ipv4",
        "Subnets": [
          {
            "Fn::ImportValue": {
              "Fn::Sub": "${FoundationStack}-PrivateA"
            }
          },
          {
            "Fn::ImportValue": {
              "Fn::Sub": "${FoundationStack}-PrivateB"
            }
          }
        ],
        "SecurityGroups": [
          {
            "Fn::ImportValue": {
              "Fn::Sub": "${FoundationStack}-AlbSecurityGroup"
            }
          }
        ],
        "LoadBalancerAttributes": [
          {
            "Key": "routing.http.drop_invalid_header_fields.enabled",
            "Value": "true"
          }
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-a2a-alb"
            }
          }
        ]
      }
    },
    "Listener": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Properties": {
        "LoadBalancerArn": {
          "Ref": "Alb"
        },
        "Port": 80,
        "Protocol": "HTTP",
        "DefaultActions": [
          {
            "Type": "fixed-response",
            "FixedResponseConfig": {
              "StatusCode": "404",
              "ContentType": "application/json",
              "MessageBody": "{\"code\":\"NETWORK_NOT_FOUND\"}"
            }
          }
        ]
      }
    },
    "TaskExecution": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": [
                "sts:AssumeRole"
              ]
            }
          ]
        },
        "ManagedPolicyArns": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
          }
        ],
        "Policies": [
          {
            "PolicyName": "OgmScopedAccess",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "secretsmanager:GetSecretValue"
                  ],
                  "Resource": [
                    {
                      "Fn::ImportValue": {
                        "Fn::Sub": "${FoundationStack}-AppSecret"
                      }
                    },
                    {
                      "Fn::ImportValue": {
                        "Fn::Sub": "${FoundationStack}-SeedSecret"
                      }
                    },
                    {
                      "Ref": "OpenAiSecretArn"
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "SimulationDiscovery": {
      "Type": "AWS::ServiceDiscovery::Service",
      "Properties": {
        "Name": "simulation",
        "NamespaceId": {
          "Ref": "Discovery"
        },
        "DnsConfig": {
          "RoutingPolicy": "MULTIVALUE",
          "DnsRecords": [
            {
              "Type": "A",
              "TTL": 10
            }
          ]
        },
        "HealthCheckCustomConfig": {
          "FailureThreshold": 1
        }
      }
    },
    "SimulationTarget": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "VpcId": {
          "Fn::ImportValue": {
            "Fn::Sub": "${FoundationStack}-VpcId"
          }
        },
        "TargetType": "ip",
        "Port": 8080,
        "Protocol": "HTTP",
        "HealthCheckPath": "/readyz",
        "HealthCheckIntervalSeconds": 15,
        "HealthCheckTimeoutSeconds": 8,
        "HealthyThresholdCount": 2,
        "UnhealthyThresholdCount": 3,
        "Matcher": {
          "HttpCode": "200"
        },
        "TargetGroupAttributes": [
          {
            "Key": "deregistration_delay.timeout_seconds",
            "Value": "15"
          }
        ]
      }
    },
    "SimulationRule": {
      "Type": "AWS::ElasticLoadBalancingV2::ListenerRule",
      "Properties": {
        "ListenerArn": {
          "Ref": "Listener"
        },
        "Priority": 10,
        "Conditions": [
          {
            "Field": "path-pattern",
            "PathPatternConfig": {
              "Values": [
                "/v1/networks/1/*",
                "/demo/v1/networks/1/*"
              ]
            }
          }
        ],
        "Actions": [
          {
            "Type": "forward",
            "TargetGroupArn": {
              "Ref": "SimulationTarget"
            }
          }
        ]
      }
    },
    "SimulationTask": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Family": {
          "Fn::Sub": "${AWS::StackName}-simulation"
        },
        "Cpu": "2048",
        "Memory": "6144",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "NetworkMode": "awsvpc",
        "RuntimePlatform": {
          "CpuArchitecture": "X86_64",
          "OperatingSystemFamily": "LINUX"
        },
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "TaskExecution",
            "Arn"
          ]
        },
        "ContainerDefinitions": [
          {
            "Name": "network",
            "Essential": true,
            "Image": {
              "Fn::Sub": [
                "${Repo}:ogm-${Release}",
                {
                  "Repo": {
                    "Fn::ImportValue": {
                      "Fn::Sub": "${FoundationStack}-RepositoryUri"
                    }
                  }
                }
              ]
            },
            "PortMappings": [
              {
                "ContainerPort": 8080,
                "Protocol": "tcp"
              }
            ],
            "StopTimeout": 30,
            "HealthCheck": {
              "Command": [
                "CMD-SHELL",
                "curl -fsS --max-time 8 http://127.0.0.1:8080/readyz >/dev/null || exit 1"
              ],
              "StartPeriod": 90,
              "Interval": 20,
              "Timeout": 10,
              "Retries": 3
            },
            "Environment": [
              {
                "Name": "NETWORK_ID",
                "Value": "1"
              },
              {
                "Name": "PEER_DOMAIN",
                "Value": {
                  "Fn::Sub": "${AWS::StackName}.ogm.internal"
                }
              },
              {
                "Name": "OWNER_HOST",
                "Value": {
                  "Fn::GetAtt": [
                    "Owner",
                    "PrivateIp"
                  ]
                }
              },
              {
                "Name": "DB_HOST",
                "Value": {
                  "Fn::ImportValue": {
                    "Fn::Sub": "${FoundationStack}-DbHost"
                  }
                }
              },
              {
                "Name": "AI_MODEL",
                "Value": {
                  "Ref": "ModelId"
                }
              },
              {
                "Name": "AI_DEFAULT_MAX_USD",
                "Value": "10"
              },
              {
                "Name": "AI_CUSTOMER_MAX_COST_USD",
                "Value": "15"
              },
              {
                "Name": "JAVA_TOOL_OPTIONS",
                "Value": "-Xms40m -Xmx550m -XX:ActiveProcessorCount=2"
              }
            ],
            "Secrets": [
              {
                "Name": "OGM_BANK_SEED",
                "ValueFrom": {
                  "Fn::ImportValue": {
                    "Fn::Sub": "${FoundationStack}-SeedSecret"
                  }
                }
              },
              {
                "Name": "OGM_APP_DB_PASSWORD",
                "ValueFrom": {
                  "Fn::ImportValue": {
                    "Fn::Sub": "${FoundationStack}-AppSecret"
                  }
                }
              },
              {
                "Name": "OPENAI_API_KEY",
                "ValueFrom": {
                  "Ref": "OpenAiSecretArn"
                }
              }
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Fn::ImportValue": {
                    "Fn::Sub": "${FoundationStack}-AppLogGroup"
                  }
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "simulation"
              }
            }
          }
        ]
      }
    },
    "SimulationService": {
      "Type": "AWS::ECS::Service",
      "Properties": {
        "Cluster": {
          "Ref": "Cluster"
        },
        "ServiceName": "simulation",
        "DesiredCount": 1,
        "LaunchType": "FARGATE",
        "PlatformVersion": "1.4.0",
        "TaskDefinition": {
          "Ref": "SimulationTask"
        },
        "HealthCheckGracePeriodSeconds": 180,
        "AvailabilityZoneRebalancing": "DISABLED",
        "DeploymentConfiguration": {
          "MaximumPercent": 100,
          "MinimumHealthyPercent": 0,
          "DeploymentCircuitBreaker": {
            "Enable": true,
            "Rollback": true
          }
        },
        "LoadBalancers": [
          {
            "TargetGroupArn": {
              "Ref": "SimulationTarget"
            },
            "ContainerName": "network",
            "ContainerPort": 8080
          }
        ],
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "DISABLED",
            "Subnets": [
              {
                "Fn::ImportValue": {
                  "Fn::Sub": "${FoundationStack}-PrivateA"
                }
              },
              {
                "Fn::ImportValue": {
                  "Fn::Sub": "${FoundationStack}-PrivateB"
                }
              }
            ],
            "SecurityGroups": [
              {
                "Fn::ImportValue": {
                  "Fn::Sub": "${FoundationStack}-AppSecurityGroup"
                }
              }
            ]
          }
        },
        "ServiceRegistries": [
          {
            "RegistryArn": {
              "Fn::GetAtt": [
                "SimulationDiscovery",
                "Arn"
              ]
            }
          }
        ]
      },
      "DependsOn": [
        "Owner",
        "SimulationRule"
      ]
    },
    "FeedbackDiscovery": {
      "Type": "AWS::ServiceDiscovery::Service",
      "Properties": {
        "Name": "feedback",
        "NamespaceId": {
          "Ref": "Discovery"
        },
        "DnsConfig": {
          "RoutingPolicy": "MULTIVALUE",
          "DnsRecords": [
            {
              "Type": "A",
              "TTL": 10
            }
          ]
        },
        "HealthCheckCustomConfig": {
          "FailureThreshold": 1
        }
      }
    },
    "FeedbackTarget": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "VpcId": {
          "Fn::ImportValue": {
            "Fn::Sub": "${FoundationStack}-VpcId"
          }
        },
        "TargetType": "ip",
        "Port": 8080,
        "Protocol": "HTTP",
        "HealthCheckPath": "/readyz",
        "HealthCheckIntervalSeconds": 15,
        "HealthCheckTimeoutSeconds": 8,
        "HealthyThresholdCount": 2,
        "UnhealthyThresholdCount": 3,
        "Matcher": {
          "HttpCode": "200"
        },
        "TargetGroupAttributes": [
          {
            "Key": "deregistration_delay.timeout_seconds",
            "Value": "15"
          }
        ]
      }
    },
    "FeedbackRule": {
      "Type": "AWS::ElasticLoadBalancingV2::ListenerRule",
      "Properties": {
        "ListenerArn": {
          "Ref": "Listener"
        },
        "Priority": 20,
        "Conditions": [
          {
            "Field": "path-pattern",
            "PathPatternConfig": {
              "Values": [
                "/v1/networks/2/*",
                "/demo/v1/networks/2/*"
              ]
            }
          }
        ],
        "Actions": [
          {
            "Type": "forward",
            "TargetGroupArn": {
              "Ref": "FeedbackTarget"
            }
          }
        ]
      }
    },
    "FeedbackTask": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Family": {
          "Fn::Sub": "${AWS::StackName}-feedback"
        },
        "Cpu": "1024",
        "Memory": "4096",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "NetworkMode": "awsvpc",
        "RuntimePlatform": {
          "CpuArchitecture": "X86_64",
          "OperatingSystemFamily": "LINUX"
        },
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "TaskExecution",
            "Arn"
          ]
        },
        "ContainerDefinitions": [
          {
            "Name": "network",
            "Essential": true,
            "Image": {
              "Fn::Sub": [
                "${Repo}:ogm-${Release}",
                {
                  "Repo": {
                    "Fn::ImportValue": {
                      "Fn::Sub": "${FoundationStack}-RepositoryUri"
                    }
                  }
                }
              ]
            },
            "PortMappings": [
              {
                "ContainerPort": 8080,
                "Protocol": "tcp"
              }
            ],
            "StopTimeout": 30,
            "HealthCheck": {
              "Command": [
                "CMD-SHELL",
                "curl -fsS --max-time 8 http://127.0.0.1:8080/readyz >/dev/null || exit 1"
              ],
              "StartPeriod": 90,
              "Interval": 20,
              "Timeout": 10,
              "Retries": 3
            },
            "Environment": [
              {
                "Name": "NETWORK_ID",
                "Value": "2"
              },
              {
                "Name": "PEER_DOMAIN",
                "Value": {
                  "Fn::Sub": "${AWS::StackName}.ogm.internal"
                }
              },
              {
                "Name": "OWNER_HOST",
                "Value": {
                  "Fn::GetAtt": [
