      "roundness": null,
      "seed": 39421303,
      "version": 1,
      "versionNonce": 252885042,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790467200000,
      "link": null,
      "locked": false,
      "fontSize": 21,
      "fontFamily": 1,
      "text": "E=0 → acceptance unavailable. Numeric sampling never interpolates through disabled sentinels. Underwriting locks apply at every gate.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "E=0 → acceptance unavailable. Numeric sampling never interpolates through disabled sentinels. Underwriting locks apply at every gate.",
