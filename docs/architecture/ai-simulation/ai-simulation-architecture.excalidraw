      "fontSize": 21,
      "fontFamily": 1,
      "text": "Example proposed budget: 1 baseline + 119 exploration + 60 refinement + 20 validation = 200 evaluation attempts.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Example proposed budget: 1 baseline + 119 exploration + 60 refinement + 20 validation = 200 evaluation attempts.",
