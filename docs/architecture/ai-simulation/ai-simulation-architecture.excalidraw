    },
    {
      "id": "s04-note-1",
      "type": "text",
      "x": 60,
      "y": 6528,
      "width": 1381.75,
      "height": 26.25,
      "angle": 0,
      "strokeColor": "#182230",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
