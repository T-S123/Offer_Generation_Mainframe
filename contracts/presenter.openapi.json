{
  "openapi": "3.1.0",
  "info": {
    "title": "Local presenter maintenance API",
    "version": "1.0.0",
    "description": "Loopback Presenter commands use the GUI session, same-origin checks and CSRF. Commands can reset the demo or append an independently tagged customer cohort."
  },
  "servers": [
    {
      "url": "/web-api"
    }
  ],
  "paths": {
    "/presenter/status": {
      "get": {
        "summary": "Read durable reset and cohort progress",
        "responses": {
          "200": {
            "description": "Current state; interrupted jobs report FAILED",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "state"
                  ],
                  "properties": {
                    "state": {
                      "type": "string",
                      "enum": [
                        "IDLE",
                        "RUNNING",
                        "READY",
                        "FAILED"
                      ]
                    },
                    "action": {
                      "type": "string",
                      "enum": [
                        "CLEAR",
                        "A2A",
                        "SIMULATE_CUSTOMERS"
                      ]
                    },
                    "requestId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "message": {
                      "type": "string"
                    },
                    "resumable": {
                      "type": "boolean",
                      "description": "Retry this tagged customer cohort with the same request ID after an interruption. Legacy jobs omit this flag."
                    },
                    "prepared": {
                      "type": "object",
                      "description": "Present on successful A2A preparation. These are starting fixture identities, not an AI publication or customer-personalized variant.",
                      "required": [
                        "customerId",
                        "customerName",
                        "customerReference",
                        "profileVersion",
                        "draftId",
                        "draftName",
                        "draftVersion",
                        "catalogOfferId",
                        "catalogOfferName",
                        "discoverySeed",
                        "validationSeed"
                      ],
                      "properties": {
                        "customerId": {
                          "type": "string"
                        },
                        "customerName": {
                          "type": "string"
                        },
                        "customerReference": {
                          "type": "string"
                        },
                        "profileVersion": {
                          "type": "integer"
                        },
                        "draftId": {
                          "type": "string"
                        },
                        "draftName": {
                          "type": "string"
                        },
                        "draftVersion": {
                          "type": "integer"
                        },
                        "catalogOfferId": {
                          "type": "string"
                        },
                        "catalogOfferName": {
                          "type": "string"
                        },
                        "discoverySeed": {
                          "type": "integer"
                        },
                        "validationSeed": {
                          "type": "integer"
                        }
                      }
                    },
                    "cohort": {
                      "type": "object",
                      "properties": {
                        "cohortId": {
                          "type": "string"
                        },
                        "size": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 10000
                        },
                        "unresolved": {
                          "type": "integer",
                          "minimum": 0
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/presenter/reset": {
      "post": {
        "summary": "Confirm a Presenter reset or additive cohort run",
        "description": "CLEAR and A2A reset local demo data and expire workspace identities. SIMULATE_CUSTOMERS appends a tagged cohort and retains workspace identities. UUIDs correlate retries and all Presenter operations are serialized.",
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "action",
                  "requestId",
                  "confirmed"
                ],
                "properties": {
                  "action": {
                    "type": "string",
                    "enum": [
                      "CLEAR",
                      "A2A",
                      "SIMULATE_CUSTOMERS"
                    ]
                  },
                  "requestId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "confirmed": {
                    "type": "boolean",
                    "const": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Durable status for this request ID",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "state"
                  ],
                  "properties": {
                    "state": {
                      "type": "string",
                      "enum": [
                        "IDLE",
                        "RUNNING",
                        "READY",
                        "FAILED"
                      ]
                    },
                    "action": {
                      "type": "string",
                      "enum": [
                        "CLEAR",
                        "A2A"
                      ]
                    },
                    "requestId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "message": {
                      "type": "string"
                    },
                    "prepared": {
                      "type": "object",
                      "description": "Present on successful A2A preparation. These are starting fixture identities, not an AI publication or customer-personalized variant.",
                      "required": [
                        "customerId",
                        "customerName",
                        "customerReference",
                        "profileVersion",
                        "draftId",
                        "draftName",
                        "draftVersion",
                        "catalogOfferId",
                        "catalogOfferName",
                        "discoverySeed",
                        "validationSeed"
                      ],
                      "properties": {
                        "customerId": {
                          "type": "string"
                        },
                        "customerName": {
                          "type": "string"
                        },
                        "customerReference": {
                          "type": "string"
                        },
                        "profileVersion": {
                          "type": "integer"
                        },
                        "draftId": {
                          "type": "string"
                        },
                        "draftName": {
                          "type": "string"
                        },
                        "draftVersion": {
                          "type": "integer"
                        },
                        "catalogOfferId": {
                          "type": "string"
                        },
                        "catalogOfferName": {
                          "type": "string"
                        },
                        "discoverySeed": {
                          "type": "integer"
                        },
                        "validationSeed": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Invalid local origin or CSRF"
          },
          "409": {
            "description": "Another reset is active or request ID used for another action"
          },
          "422": {
            "description": "Invalid command or missing confirmation"
          },
          "503": {
            "description": "Local coordinator unavailable"
          }
        }
      }
    }
  }
}
