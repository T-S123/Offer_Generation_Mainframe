# Copy settings into ignored runtime/ai.env. Do not commit actual keys or passwords.
# Supply OPENAI_API_KEY securely in your local environment or runtime/ai.env.
# AI_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/DATABASE
# Existing runtime/local.env DATABASE_URL can also supply the local PostgreSQL connection.
AI_BASE_PORT=8100
AI_ANALYST_ID=local-analyst
AI_DEFAULT_MAX_USD=25
AI_MAX_USD_PER_TOKEN=0.00005
AI_FOLLOW_UP_DAYS=14
AI_ENABLE_OCR=false
# AI_POLICY_DIR=/absolute/path/to/policy-documents
# AI_MCP_CONFIG=/absolute/path/to/mcp-servers.json
# Optional authenticated operational adapter:
# AI_OUTCOME_SOURCE_ID=customer-production-system
# AI_OUTCOME_SOURCE_MODE=OBSERVED_REAL
