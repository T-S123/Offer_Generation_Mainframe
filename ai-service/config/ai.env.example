# Copy settings into ignored runtime/ai.env. Do not commit actual keys or passwords.
# Supply OPENAI_API_KEY securely in your local environment or runtime/ai.env.
# AI_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/DATABASE
# Existing runtime/local.env DATABASE_URL can also supply the local PostgreSQL connection.
AI_BASE_PORT=8100
# Feedback base defaults to AI_BASE_PORT + 10. Its roles use offsets 0, 1, 4, 5 and 6.
# AI_FEEDBACK_BASE_PORT=8110
AI_ANALYST_ID=local-analyst
AI_DEFAULT_MAX_USD=25
AI_MAX_USD_PER_TOKEN=0.00005
AI_FOLLOW_UP_DAYS=14
AI_ENABLE_OCR=false
# AI_POLICY_DIR=/absolute/path/to/policy-documents
# AI_MCP_CONFIG=/absolute/path/to/mcp-servers.json
# AI_CREDENTIAL_FILE=/absolute/path/to/simulation-role-credentials.json
# AI_FEEDBACK_CREDENTIAL_FILE=/absolute/path/to/feedback-role-credentials.json
# AI_FEEDBACK_MCP_CONFIG=/absolute/path/to/feedback-mcp-servers.json
# Optional authenticated operational adapter:
# AI_OUTCOME_SOURCE_ID=customer-production-system
# AI_OUTCOME_SOURCE_MODE=OBSERVED_REAL

# Dashboard-only mode: run scripts/run-ai.ps1 -PerformanceOnly instead of the full launcher.
# It requires the same database and engine, but no OPENAI_API_KEY and starts no agent workers.
# Feedback Customer Eligibility uses AI_FEEDBACK_BASE_PORT + 6 (default 8116).

# Customer personalization: explicit button, five separate agents (offsets 0, 7, 2, 6, 8).
# AI_PERSONALIZATION_BASE_PORT=8120
# AI_PERSONALIZATION_CREDENTIAL_FILE=/absolute/path/to/personalization-role-credentials.json
# Per saved-profile run ceiling; greater than zero and at most 15 USD.
AI_CUSTOMER_MAX_COST_USD=15
